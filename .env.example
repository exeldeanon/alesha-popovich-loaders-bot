TELEGRAM_BOT_TOKEN=
BOT_ADMIN_IDS=
BOT_ADMIN_USERNAMES=AleshaPopovichManager
BOT_DB_PATH=data/bot.sqlite
BOT_REMINDER_MINUTES=120

# Автоматические заказы. 1 = включить генератор.
BOT_AUTO_ORDERS=0

# Средняя интенсивность генерации на один активный регион.
BOT_AUTO_ORDERS_PER_HOUR=1.5

# Максимум одновременно активных автозаказов на регион.
BOT_AUTO_ORDER_MAX_ACTIVE=3

# Доля срочных заказов от 0 до 0.9.
BOT_URGENT_ORDER_CHANCE=0.35

# Только для тестовой/демо-среды.
# При 1 бот может показывать синтетическую динамику заполнения,
# которая в интерфейсе менеджера помечается как демо.
BOT_SIMULATION_MODE=0

# Геокодирование регионов РФ и реальные адреса из OpenStreetMap.
# URL вынесены в настройки, чтобы при росте нагрузки можно было перейти на свой/платный сервис.
BOT_NOMINATIM_URL=https://nominatim.openstreetmap.org
BOT_OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
BOT_OSM_USER_AGENT=AleshaPopovichLoadersBot/1.0 (+https://github.com/exeldeanon/alesha-popovich-loaders-bot)
